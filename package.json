{
  "name": "sopham",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "branding:sync": "node scripts/sync-branding.mjs",
    "predev": "npm run branding:sync",
    "dev": "next dev",
    "prebuild": "npm run branding:sync",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "pretest": "npm run branding:sync",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "typescript": "^5",
    "wrangler": "^4.158.0"
  }
}
